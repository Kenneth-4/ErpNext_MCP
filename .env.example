# ERPNext MCP Server Environment Configuration Example
# Copy this file to .env and configure with your ERPNext / Frappe instance details

# (Required) Base URL of your Frappe / ERPNext instance
ERPNEXT_URL=https://my-erp.example.com

# (Optional) User API Key generated in ERPNext user profile
ERPNEXT_API_KEY=your_api_key_here

# (Optional) User API Secret generated in ERPNext user profile
ERPNEXT_API_SECRET=your_api_secret_here
